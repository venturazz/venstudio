# Local development: cp .env.example .env.local
DATABASE_URL=postgres://venstudio:venstudio@localhost:5432/venstudio
APP_URL=http://localhost:3000
# openssl rand -base64 32
ENCRYPTION_KEY=
SETUP_TOKEN=dev-setup-token
ARTIFACT_DIR=./data/artifacts
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=

# Hermes Agent API server (the studio's brain). Internal address only, never a public domain.
# Same server, both on the coolify network: http://<hermes container name>:8642
HERMES_BASE_URL=
# Must equal API_SERVER_KEY in Hermes (openssl rand -hex 32).
HERMES_API_KEY=

# Kokoro TTS (OpenAI-compatible, e.g. Kokoro-FastAPI). Leave empty until it is running.
KOKORO_BASE_URL=
KOKORO_API_KEY=
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_heart
# hermes-capcut (Hermes runs its CapCut workflow when Kokoro cannot) or off
TTS_BACKUP=hermes-capcut
# Optional hint for Hermes image_gen, e.g. cloudflare,qwen,minimax
HERMES_IMAGE_PROVIDER_ORDER=
HERMES_MEDIA_ORIGINS=
# Optional: Hermes model turns the portal runs at once (default 1, at most 8). Raise only if Hermes takes parallel turns.
HERMES_MAX_CONCURRENCY=
# 1 lets the studio send Muse agent tasks (last picture fallback, and the Workers page test). docs/muse-agent-tasks.md
MUSE_AGENT_TASKS=0
# 1 (default): when Hermes is busy, idea/research/script/storyboard go to a ready Muse worker instead of waiting. Needs MUSE_AGENT_TASKS=1.
MUSE_OVERFLOW=1
