# Public domain pointing at this server (A/AAAA record). Caddy fetches the TLS certificate.
DOMAIN=studio.example.com

# openssl rand -base64 24
POSTGRES_PASSWORD=

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts 2FA secrets (and later YouTube tokens). Back it up; losing it means re-enrolling 2FA.
ENCRYPTION_KEY=

# One-time token for creating the owner account at https://$DOMAIN/setup.
# openssl rand -hex 16   -- remove it after setup and restart.
SETUP_TOKEN=

# 9router OpenAI-compatible endpoint, reachable from the portal container.
# Same host, outside Docker: http://host.docker.internal:20128
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=

# Largest artifact a worker may upload, in MB.
MAX_ARTIFACT_MB=2048
