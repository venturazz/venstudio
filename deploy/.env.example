# Public domain pointing at this server (A/AAAA record). Caddy fetches the TLS certificate.
DOMAIN=studio.example.com

# openssl rand -base64 24
POSTGRES_PASSWORD=

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts 2FA secrets (and later YouTube tokens). Back it up; losing it means re-enrolling 2FA.
ENCRYPTION_KEY=

# One-time token for creating the owner account at https://$DOMAIN/setup.
# openssl rand -hex 16   -- remove it after setup and restart.
SETUP_TOKEN=

# 9router OpenAI-compatible endpoint, reachable from the portal container.
# Same host, outside Docker: http://host.docker.internal:20128
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=

# Largest artifact a worker may upload, in MB.
MAX_ARTIFACT_MB=2048

# Hermes Agent API server (the studio's brain). Internal address only, never a public domain.
# Same server, both on the coolify network: http://<hermes container name>:8642
HERMES_BASE_URL=
# Must equal API_SERVER_KEY in Hermes (openssl rand -hex 32).
HERMES_API_KEY=

# Where the studio reads the files Hermes generates. See docs/deploy-hermes-media.md.
# A path is allowed: the agent appends the bare file name to this value.
#   self-host overlay: http://hermes-files:8000/img   and   http://hermes-files:8000/tts
#   Coolify:           http://hermes-files:8000/img
HERMES_IMAGE_MEDIA_ORIGIN=
HERMES_TTS_MEDIA_ORIGIN=
# Where the portal reads generated video clips from. Same origin as above, different directory.
HERMES_VIDEO_MEDIA_ORIGIN=
# Allowlist for downloading those URLs. Full origins, comma list; the portal strips any path.
# Leave empty only if the media host is the same origin as HERMES_BASE_URL.
HERMES_MEDIA_ORIGINS=

# Host path of the Hermes container's /opt/data, mounted read-only by the media host overlay.
# docker volume inspect <hermes data volume> | grep Mountpoint
HERMES_DATA_DIR=
